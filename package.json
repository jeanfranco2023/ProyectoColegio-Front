{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:render": "ng serve --proxy-config proxy.render.conf.json",
    "build": "ng build",
    "test:integration": "node scripts/integration_e2e.mjs",
    "test:modules:isolated": "node scripts/module_integration_e2e.mjs",
    "test:real:ui": "node scripts/real_environment_smoke.mjs",
    "test:real:api": "node scripts/real_api_read_smoke.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.4.2",
  "dependencies": {
    "@angular/animations": "21.2.25",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "pg": "^8.23.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.3",
    "@angular/cli": "^21.0.3",
    "@angular/compiler-cli": "21.2.25",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.28",
    "puppeteer-core": "^25.11.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
